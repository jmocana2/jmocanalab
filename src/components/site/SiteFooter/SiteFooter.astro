---
/*
 * SiteFooter.astro — pie del sitio. Año en curso y crédito con enlace al
 * perfil de LinkedIn (decisión de 01-decisiones.md). El corazón va en rojo;
 * el resto del texto, en tinta.
 */
import './SiteFooter.css';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="site-footer__credit">
    Hecho por <a
      class="site-footer__link"
      href="https://www.linkedin.com/in/jmocanalab"
      rel="me noopener"
      target="_blank">jmocana</a
    > con <svg
      class="site-footer__heart"
      viewBox="0 0 16 16"
      width="12"
      height="12"
      aria-label="amor"
      role="img"
    >
      <path
        d="M8 14s-5-3.2-5-7.3C3 4.7 4.5 3 6.4 3c1 0 1.9.5 2.6 1.4C9.7 3.5 10.6 3 11.6 3 13.5 3 15 4.7 15 6.7 15 10.8 10 14 10 14z"
        fill="currentColor"></path>
    </svg>
    <span class="site-footer__year">· {year}</span>
  </p>
</footer>

