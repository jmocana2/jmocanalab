---
/*
 * [slug].astro — ficha de un experimento. La página solo resuelve la ruta y el número;
 * la ficha entera la pinta LabDetail.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LabDetail from '../../../components/lab/LabDetail/LabDetail.astro';
import type { Lab } from '../../../types';
import { labNumber } from '../../../utils/lab-number';
import { labSlug } from '../../../utils/lab-paths';

export const getStaticPaths = (async () => {
  const labs = await getCollection('labs');

  return labs.map((lab) => ({
    params: { category: lab.data.category, slug: labSlug(lab) },
    props: { lab, number: labNumber(lab, labs) },
  }));
}) satisfies GetStaticPaths;

type Props = {
  lab: Lab;
  number: number;
};

const { lab, number } = Astro.props;
const { title, summary, category } = lab.data;
---

<BaseLayout
  title={`${title} · jmocanalab`}
  description={summary}
  activeCategory={category}
  isDetail
>
  <LabDetail lab={lab} number={number} />
</BaseLayout>
