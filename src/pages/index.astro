---
/*
 * index.astro — portada: todos los experimentos, de todas las categorías, del más
 * reciente al más antiguo. Filtrar por categoría es cosa de la nav. Si no hay ninguno, no
 * se pinta la sección: un encabezado sobre una lista vacía no dice nada.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LabList from '../components/lab/LabList/LabList.astro';
import { labNumber } from '../utils/lab-number';

const labs = await getCollection('labs');

const latest = labs
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((lab) => ({ lab, number: labNumber(lab, labs) }));
---

<BaseLayout title="jmocanalab" description="Laboratorio y portfolio front-end." isHome>
  {latest.length > 0 && <LabList heading="Recientes" items={latest} view="latest" />}
</BaseLayout>
